; ============================================================
; D-101  CHASSIS BASE PLATE - PLAN VIEW
; TEC PV-CLEANING ROBOT, REE598 GRADUATION PROJECT
; UNITS MM. GEOMETRY 1:1, PLOT 1:2 ON A3
; RUN: NEW DRAWING FROM acadiso.dwt, THEN COMMAND: SCRIPT
; BLANK LINES ARE DELIBERATE ENTER KEYSTROKES - KEEP THEM
; ============================================================
FILEDIA 0
EXPERT 3
OSMODE 0
INSUNITS 4
LTSCALE 2
-LINETYPE L HIDDEN acadiso.lin L CENTER acadiso.lin

-LAYER N OUTLINE,HIDDEN,CENTER,DIM,TEXT C 7 OUTLINE C 1 HIDDEN C 2 CENTER C 3 DIM C 4 TEXT L HIDDEN HIDDEN L CENTER CENTER S OUTLINE

DIMSCALE 2
DIMTXT 3.5
DIMASZ 2.5
DIMEXO 1
DIMEXE 1.5
DIMDEC 1
DIMZIN 8
; ---- sheet frame and title block ----
RECTANG -130,-170 730,460
RECTANG 350,-170 730,-90
LINE 350,-130 730,-130

LINE 560,-170 560,-90

CLAYER TEXT
-TEXT 360,-118 10 0 D-101  CHASSIS BASE PLATE
-TEXT 360,-158 7 0 TEC PV-CLEANING ROBOT - REE598 - 2026-06-12
-TEXT 570,-118 7 0 SCALE 1:2  SHEET A3
-TEXT 570,-158 7 0 UNITS MM - TOL ISO 2768-m
; ---- plate outline 400 x 300, corner R10 ----
CLAYER OUTLINE
RECTANG F 10 0,0 400,300
; ---- wheel clearance slots 2x 80 x 26, corner R3 ----
RECTANG F 3 40,7 120,33
RECTANG 40,267 120,293
; ---- motor bracket holes 8x DIA 4.5 (M4), pattern 28 x 44 ----
CIRCLE 66,41 2.25
CIRCLE 94,41 2.25
CIRCLE 66,85 2.25
CIRCLE 94,85 2.25
CIRCLE 66,215 2.25
CIRCLE 94,215 2.25
CIRCLE 66,259 2.25
CIRCLE 94,259 2.25
; ---- caster holes 4x DIA 4.5 (M4 CSK) ----
CIRCLE 355,100 2.25
CIRCLE 385,100 2.25
CIRCLE 355,200 2.25
CIRCLE 385,200 2.25
; ---- tank strap holes 4x DIA 5, pattern 180 x 240 ----
CIRCLE 165,30 2.5
CIRCLE 345,30 2.5
CIRCLE 165,270 2.5
CIRCLE 345,270 2.5
; ---- electronics deck standoffs 4x DIA 3.2 (M3), pattern 130 x 80 ----
CIRCLE 20,120 1.6
CIRCLE 150,120 1.6
CIRCLE 20,200 1.6
CIRCLE 150,200 1.6
; ---- pump bracket holes 2x DIA 4.5 (M4), pitch 36 ----
CIRCLE 350,45 2.25
CIRCLE 386,45 2.25
; ---- brush arm holes 4x DIA 4.5 (M4), 2 per arm at pitch 20 ----
CIRCLE 370,22 2.25
CIRCLE 390,22 2.25
CIRCLE 370,278 2.25
CIRCLE 390,278 2.25
; ---- component bays (reference, hidden) ----
CLAYER HIDDEN
RECTANG F 0 170,35 340,265
RECTANG 10,110 160,210
; ---- centerlines: drive axle and plate mid ----
CLAYER CENTER
LINE 80,-15 80,315

LINE -15,150 415,150

; ---- dimensions ----
CLAYER DIM
DIMLINEAR 0,0 400,0 200,-40
DIMLINEAR 0,0 0,300 -50,150
DIMLINEAR 0,0 80,0 40,-22
DIMLINEAR 40,7 120,7 80,-58
DIMLINEAR 66,41 94,41 80,58
DIMLINEAR 66,41 66,85 38,63
DIMLINEAR 165,30 345,30 255,-22
DIMLINEAR 20,120 20,200 -22,160
DIMLINEAR 355,100 385,100 370,120
DIMLINEAR 370,22 390,22 380,42
; ---- callouts ----
CLAYER TEXT
-TEXT 30,95 6 0 A  8x %%C4.5 MOTOR BRACKET (M4)
-TEXT 250,110 6 0 B  4x %%C4.5 CASTER (M4 CSK)
-TEXT 200,282 6 0 C  4x %%C5 TANK STRAP
-TEXT 30,222 6 0 D  4x %%C3.2 ELX DECK (M3)
-TEXT 300,57 6 0 E  2x %%C4.5 PUMP (M4)
-TEXT 280,10 6 0 F  4x %%C4.5 BRUSH ARM (M4)
-TEXT 175,150 6 0 TANK BAY 170x230 (REF, D-105)
-TEXT 30,180 6 0 ELX BAY 150x100 (REF, D-106)
-TEXT 45,-12 6 0 WHEEL SLOT 80x26 (2x)
-TEXT 408,40 6 90 FRONT - BRUSH END
-TEXT -25,40 6 90 REAR - DRIVE AXLE
-TEXT 88,318 6 0 DRIVE AXLE CL - TRACK 260, WHEELS IN SLOTS (SEE D-102)
; ---- notes ----
-TEXT -120,448 7 0 NOTES:
-TEXT -120,434 7 0 1. MATERIAL AL 6061-T6 PLATE, THK 3 MM, LASER CUT, DEBURR ALL EDGES
-TEXT -120,420 7 0 2. ALL HOLES THRU. CSK 90 DEG FOR M4 FLAT HEAD AT CASTER HOLES (B)
-TEXT -120,406 7 0 3. MOTOR BRACKET HOLES (A): POSITION TOL %%C0.2 TO AXLE CL (DATUM A)
-TEXT -120,392 7 0 4. GENERAL TOLERANCES ISO 2768-m. MASS OF FINISHED PART 0.90 KG
-TEXT -120,378 7 0 5. PLATE IS CHASSIS FLOOR. TEC SANDWICH (D-104) MOUNTS ON TANK LID, SEE D-107
-TEXT 410,448 7 0 HOLE TABLE: A %%C4.5 x8 - B %%C4.5 x4 CSK - C %%C5 x4
-TEXT 410,434 7 0 D %%C3.2 x4 - E %%C4.5 x2 - F %%C4.5 x4
ZOOM E
EXPERT 0
FILEDIA 1
