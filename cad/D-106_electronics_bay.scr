; ============================================================
; D-106  ELECTRONICS BAY - ESP32 + INA219 + DRIVER STANDOFFS
; TEC PV-CLEANING ROBOT, REE598 GRADUATION PROJECT
; UNITS MM. GEOMETRY 1:1, PLOT 1:1 ON A4
; VIEWS: DECK PLAN + SIDE ELEVATION
; BLANK LINES ARE DELIBERATE ENTER KEYSTROKES - KEEP THEM
; ============================================================
FILEDIA 0
EXPERT 3
OSMODE 0
INSUNITS 4
LTSCALE 1
-LINETYPE L HIDDEN acadiso.lin L CENTER acadiso.lin

-LAYER N OUTLINE,HIDDEN,CENTER,DIM,TEXT C 7 OUTLINE C 1 HIDDEN C 2 CENTER C 3 DIM C 4 TEXT L HIDDEN HIDDEN L CENTER CENTER S OUTLINE

DIMSCALE 1
DIMTXT 3
DIMASZ 2.5
DIMEXO 1
DIMEXE 1.5
DIMDEC 1
DIMZIN 8
; ---- sheet frame and title block ----
RECTANG -30,-70 270,200
RECTANG 90,-70 270,-30
LINE 90,-50 270,-50

LINE 180,-70 180,-30

CLAYER TEXT
-TEXT 95,-44 6 0 D-106  ELECTRONICS BAY
-TEXT 95,-64 4 0 TEC PV-CLEAN ROBOT - REE598 - 2026-06-12
-TEXT 185,-44 4 0 SCALE 1:1  SHEET A4
-TEXT 185,-64 4 0 UNITS MM - ISO 2768-m
; ============================================================
; DECK PLAN - acrylic 150 x 100 x 3, origin 0,0
; ============================================================
CLAYER OUTLINE
RECTANG F 3 0,0 150,100
; chassis standoff holes 4x DIA 3.2 at 130 x 80 (match D-101 D)
CIRCLE 10,10 1.6
CIRCLE 140,10 1.6
CIRCLE 10,90 1.6
CIRCLE 140,90 1.6
; ESP32 DevKitC footprint 55 x 28, 4x M3 at 48 x 22, at (15,62)
CLAYER HIDDEN
RECTANG F 0 15,62 70,90
CLAYER OUTLINE
CIRCLE 18.5,65 1.6
CIRCLE 66.5,65 1.6
CIRCLE 18.5,87 1.6
CIRCLE 66.5,87 1.6
; motor driver TB6612/L298N footprint 43 x 43, 4x M3 at 37 x 37, at (90,50)
CLAYER HIDDEN
RECTANG 90,50 133,93
CLAYER OUTLINE
CIRCLE 93,53 1.6
CIRCLE 130,53 1.6
CIRCLE 93,90 1.6
CIRCLE 130,90 1.6
; INA219 module 26 x 20, 2x M3 at 20, at (15,30)
CLAYER HIDDEN
RECTANG 15,30 41,50
CLAYER OUTLINE
CIRCLE 18,40 1.6
CIRCLE 38,40 1.6
; buck converter 43 x 21, 2x M3 at 37, at (90,20)
CLAYER HIDDEN
RECTANG 90,20 133,41
CLAYER OUTLINE
CIRCLE 93,30 1.6
CIRCLE 130,30 1.6
; battery zone 98 x 18 (ref) front strip
CLAYER HIDDEN
RECTANG 26,3 124,18
CLAYER CENTER
LINE 75,-8 75,108

LINE -8,50 158,50

; ---- dims ----
CLAYER DIM
DIMLINEAR 0,0 150,0 75,-18
DIMLINEAR 0,0 0,100 -18,50
DIMLINEAR 10,10 140,10 75,16
DIMLINEAR 18.5,65 66.5,65 42,70
DIMLINEAR 93,53 130,53 111,58
; ---- callouts ----
CLAYER TEXT
-TEXT 16,94 4 0 ESP32 DEVKITC (M3 48x22)
-TEXT 90,96 4 0 DRIVER (M3 37x37)
-TEXT 15,24 4 0 INA219 (M3 x20)
-TEXT 90,14 4 0 BUCK (M3 x37)
-TEXT 30,7 4 0 BATTERY 12V (REF)
; ============================================================
; SIDE ELEVATION at y offset 130
; ============================================================
CLAYER OUTLINE
RECTANG 0,130 150,133
; standoffs M3 x 10 below deck
RECTANG 8,120 12,130
RECTANG 138,120 142,130
LINE 0,120 150,120

; cover acrylic 150 x 100 x 3 at 35 above deck on M3 x 35 posts
RECTANG 0,168 150,171
RECTANG 8,133 12,168
RECTANG 138,133 142,168
CLAYER DIM
DIMLINEAR 0,120 0,130 -16,125
DIMLINEAR 0,133 0,168 -16,150
CLAYER TEXT
-TEXT 30,174 4 0 COVER ACRYLIC 3 THK, VENT SLOTS 4x 40x3
-TEXT 30,138 4 0 SIDE ELEV - DECK ON M3x10 STANDOFFS (CHASSIS), COVER ON M3x35
; ---- notes ----
-TEXT -20,194 4 0 NOTES: 1. DECK + COVER CLEAR ACRYLIC 3 MM, LASER CUT. 2. ALL STANDOFFS M3 BRASS.
-TEXT -20,188 4 0 3. WIRING EXITS REAR EDGE, GROMMET %%C8. 4. BAY MASS 0.37 KG INCL BOARDS + BATTERY.
ZOOM E
EXPERT 0
FILEDIA 1
