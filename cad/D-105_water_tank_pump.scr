; ============================================================
; D-105  WATER TANK 3.6 L + PUMP MOUNT
; TEC PV-CLEANING ROBOT, REE598 GRADUATION PROJECT
; UNITS MM. GEOMETRY 1:1, PLOT 1:2 ON A3
; VIEWS: TANK PLAN + FRONT ELEVATION + PUMP BRACKET
; BLANK LINES ARE DELIBERATE ENTER KEYSTROKES - KEEP THEM
; ============================================================
FILEDIA 0
EXPERT 3
OSMODE 0
INSUNITS 4
LTSCALE 2
-LINETYPE L HIDDEN acadiso.lin L CENTER acadiso.lin

-LAYER N OUTLINE,HIDDEN,CENTER,DIM,TEXT C 7 OUTLINE C 1 HIDDEN C 2 CENTER C 3 DIM C 4 TEXT L HIDDEN HIDDEN L CENTER CENTER S OUTLINE

DIMSCALE 2
DIMTXT 3.5
DIMASZ 2.5
DIMEXO 1
DIMEXE 1.5
DIMDEC 1
DIMZIN 8
; ---- sheet frame and title block ----
RECTANG -70,-110 560,330
RECTANG 260,-110 560,-50
LINE 260,-80 560,-80

LINE 420,-110 420,-50

CLAYER TEXT
-TEXT 270,-72 8 0 D-105  WATER TANK 3.6 L + PUMP
-TEXT 270,-102 5 0 TEC PV-CLEAN ROBOT - REE598 - 2026-06-12
-TEXT 430,-72 5 0 SCALE 1:2  SHEET A3
-TEXT 430,-102 5 0 UNITS MM - ISO 2768-m
; ============================================================
; VIEW 1 - TANK PLAN 170 x 230 external, origin 0,0
; ============================================================
CLAYER OUTLINE
RECTANG F 5 0,0 170,230
; internal wall (2 mm HDPE) hidden
CLAYER HIDDEN
RECTANG F 0 2,2 168,228
; filler cap DIA 40 top rear
CLAYER OUTLINE
CIRCLE 85,40 20
CIRCLE 85,40 16
; strap lugs 4x, 10 x 14, holes DIA 5 at pattern 180 x 240
LINE -5,23 0,23

LINE -5,37 0,37

LINE -5,23 -5,37

CIRCLE -5,30 2.5
LINE 175,23 170,23

LINE 175,37 170,37

LINE 175,23 175,37

CIRCLE 175,30 2.5
LINE -5,193 0,193

LINE -5,207 0,207

LINE -5,193 -5,207

CIRCLE -5,200 2.5
LINE 175,193 170,193

LINE 175,207 170,207

LINE 175,193 175,207

CIRCLE 175,200 2.5
; condensate inlet DIA 8 (from D-104 gutter drain), top front
CIRCLE 85,200 4
; level switch boss DIA 16 (reed float), top center
CIRCLE 30,115 8
CLAYER CENTER
LINE 85,-10 85,240

LINE -14,115 184,115

; ---- dims, plan ----
CLAYER DIM
DIMLINEAR 0,0 170,0 85,-30
DIMLINEAR 0,0 0,230 -34,115
DIMDIAMETER 99.14,54.14 130,75
; ---- callouts, plan ----
CLAYER TEXT
-TEXT 8,240 5 0 TANK PLAN - LUG HOLES %%C5 MATCH D-101 C (PATTERN 180x240)
-TEXT 95,205 5 0 INLET %%C8 FROM D-104 DRAIN
-TEXT 42,112 5 0 LEVEL SWITCH BOSS %%C16
; ============================================================
; VIEW 2 - FRONT ELEVATION at x offset 260: 170 wide x 100 high
; ============================================================
CLAYER OUTLINE
RECTANG F 0 260,0 430,100
; wall hidden
CLAYER HIDDEN
RECTANG 262,2 428,98
; outlet barb DIA 8 bottom right
CLAYER OUTLINE
RECTANG 430,8 442,16
; cap on top
RECTANG 329,100 361,108
; fill level 3.6 L (line at 96 internal)
CLAYER HIDDEN
LINE 262,93 428,93

CLAYER DIM
DIMLINEAR 260,0 430,0 345,-22
DIMLINEAR 430,0 430,100 462,50
CLAYER TEXT
-TEXT 270,110 5 0 FRONT ELEV - WORKING LEVEL 3.6 L AT H=93 INT
-TEXT 434,24 5 0 OUTLET BARB %%C8 TO PUMP
; ============================================================
; VIEW 3 - PUMP + BRACKET at offset 260,160
; 12 V diaphragm pump 90 x 40 x 35, bracket 2x M4 pitch 36
; ============================================================
CLAYER OUTLINE
RECTANG F 2 260,160 350,200
; bracket feet
LINE 287,160 287,152

LINE 323,160 323,152

LINE 279,152 331,152

CIRCLE 287,156 2.25
CIRCLE 323,156 2.25
; ports
RECTANG 350,170 360,178
RECTANG 350,184 360,192
CLAYER CENTER
LINE 305,146 305,206

CLAYER DIM
DIMLINEAR 260,160 350,160 305,214
DIMLINEAR 287,156 323,156 305,138
CLAYER TEXT
-TEXT 364,180 5 0 IN/OUT %%C8 BARBS
-TEXT 250,226 5 0 PUMP PLAN - 12V DIAPHRAGM 90x40x35, FEET 2x %%C4.5 PITCH 36 (D-101 E)
; ---- notes ----
-TEXT -60,318 5 0 NOTES: 1. TANK HDPE 2 MM, WELDED SEAMS. INTERNAL 166x226x96 = 3.60 L WORKING.
-TEXT -60,308 5 0 2. VENT %%C4 IN CAP. ALL BARBS %%C8 FOR 8x11 SILICONE HOSE.
-TEXT -60,298 5 0 3. STRAPS: 2x VELCRO 25 WIDE OVER TANK, BOLTED AT LUGS.
-TEXT -60,288 5 0 4. MASS: TANK 0.28 KG + PUMP 0.12 KG DRY; +1.8 KG AT MEAN FILL.
ZOOM E
EXPERT 0
FILEDIA 1
