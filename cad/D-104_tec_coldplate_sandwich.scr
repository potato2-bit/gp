; ============================================================
; D-104  4-TILE TEC COLD-PLATE SANDWICH (2x2, TEC1-12706)
; TEC PV-CLEANING ROBOT, REE598 GRADUATION PROJECT
; UNITS MM. GEOMETRY 1:1, PLOT 1:2 ON A3
; VIEWS: COLD-PLATE PLAN + SECTION + FAN/DUCT PLATE
; BLANK LINES ARE DELIBERATE ENTER KEYSTROKES - KEEP THEM
; ============================================================
FILEDIA 0
EXPERT 3
OSMODE 0
INSUNITS 4
LTSCALE 2
-LINETYPE L HIDDEN acadiso.lin L CENTER acadiso.lin

-LAYER N OUTLINE,HIDDEN,CENTER,DIM,TEXT C 7 OUTLINE C 1 HIDDEN C 2 CENTER C 3 DIM C 4 TEXT L HIDDEN HIDDEN L CENTER CENTER S OUTLINE

DIMSCALE 2
DIMTXT 3.5
DIMASZ 2.5
DIMEXO 1
DIMEXE 1.5
DIMDEC 1
DIMZIN 8
; ---- sheet frame and title block ----
RECTANG -70,-120 620,330
RECTANG 320,-120 620,-60
LINE 320,-90 620,-90

LINE 480,-120 480,-60

CLAYER TEXT
-TEXT 330,-82 8 0 D-104  TEC COLD-PLATE SANDWICH
-TEXT 330,-112 5 0 TEC PV-CLEAN ROBOT - REE598 - 2026-06-12
-TEXT 490,-82 5 0 SCALE 1:2  SHEET A3
-TEXT 490,-112 5 0 UNITS MM - ISO 2768-m
; ============================================================
; VIEW 1 - COLD PLATE PLAN 170x170, origin 0,0 (TEC side)
; TEC pockets 40x40x0.5 at pitch 85, centers (42.5/127.5)
; ============================================================
CLAYER OUTLINE
RECTANG F 5 0,0 170,170
; TEC pockets 40 x 40 (machined 0.5 deep)
RECTANG F 0 22.5,22.5 62.5,62.5
RECTANG 107.5,22.5 147.5,62.5
RECTANG 22.5,107.5 62.5,147.5
RECTANG 107.5,107.5 147.5,147.5
; clamp holes 8x DIA 4.5 (M4 + nylon shoulder washer)
CIRCLE 85,10 2.25
CIRCLE 85,85 2.25
CIRCLE 85,160 2.25
CIRCLE 10,85 2.25
CIRCLE 160,85 2.25
CIRCLE 10,10 2.25
CIRCLE 160,10 2.25
CIRCLE 10,160 2.25
; gutter along low edge (12 x 12 channel, full width)
CLAYER HIDDEN
RECTANG 0,-14 170,-2
; drain barb DIA 8 at gutter center
CIRCLE 85,-8 4
CLAYER CENTER
LINE 85,-22 85,178

LINE -8,85 178,85

LINE 42.5,14 42.5,156

LINE 127.5,14 127.5,156

LINE 14,42.5 156,42.5

LINE 14,127.5 156,127.5

; ---- dims, plan ----
CLAYER DIM
DIMLINEAR 0,0 170,0 85,-40
DIMLINEAR 0,0 0,170 -34,85
DIMLINEAR 22.5,22.5 62.5,22.5 42.5,-16
DIMLINEAR 42.5,22.5 127.5,22.5 85,30
DIMLINEAR 10,10 85,10 47,-26
; ---- callouts, plan ----
CLAYER TEXT
-TEXT 20,178 5 0 COLD PLATE AL 6061 170x170x3 - 4x TEC POCKET 40x40x0.5
-TEXT 95,68 5 0 8x %%C4.5 CLAMP (M4)
-TEXT 100,-10 5 0 GUTTER 12x12 + DRAIN %%C8 TO TANK (D-105)
; ============================================================
; VIEW 2 - SECTION A-A at x offset 250, y 220..300
; stack: cold plate 3 / TEC 3.6 / hot sink 80x80x25
; ============================================================
CLAYER OUTLINE
RECTANG 250,260 420,263
RECTANG 270,256.4 310,260
RECTANG 360,256.4 400,260
RECTANG 250,231.4 420,256.4
; fin lines in sink field
LINE 260,231.4 260,256.4

LINE 280,231.4 280,256.4

LINE 300,231.4 300,256.4

LINE 320,231.4 320,256.4

LINE 340,231.4 340,256.4

LINE 360,231.4 360,256.4

LINE 380,231.4 380,256.4

LINE 400,231.4 400,256.4

; airflow arrow through fins
LINE 425,244 445,244

LINE 440,247 445,244

LINE 440,241 445,244

CLAYER DIM
DIMLINEAR 420,260 420,263 448,261.5
DIMLINEAR 420,256.4 420,260 470,258
DIMLINEAR 420,231.4 420,256.4 492,244
CLAYER TEXT
-TEXT 250,290 5 0 SECTION A-A: COLD PLATE 3 / TEC1-12706 3.6 / HOT SINK FIELD 160x160x25
-TEXT 250,278 5 0 THERMAL PASTE BOTH FACES. CLAMP TORQUE M4 = 1.2 N-M
-TEXT 425,232 5 0 HOT AIR OUT
; ============================================================
; VIEW 3 - FAN/DUCT PLATE at x offset 250, y 0..90
; 2x 80 mm axial fans, cutout DIA 76, holes 71.5 sq pattern
; ============================================================
CLAYER OUTLINE
RECTANG F 3 250,0 430,90
CIRCLE 295,45 38
CIRCLE 385,45 38
CIRCLE 259.25,9.25 2.25
CIRCLE 330.75,9.25 2.25
CIRCLE 259.25,80.75 2.25
CIRCLE 330.75,80.75 2.25
CIRCLE 349.25,9.25 2.25
CIRCLE 420.75,9.25 2.25
CIRCLE 349.25,80.75 2.25
CIRCLE 420.75,80.75 2.25
CLAYER CENTER
LINE 295,-6 295,96

LINE 385,-6 385,96

LINE 244,45 436,45

CLAYER DIM
DIMLINEAR 250,0 430,0 340,-18
DIMLINEAR 259.25,9.25 330.75,9.25 295,18
CLAYER TEXT
-TEXT 250,100 5 0 FAN PLATE AL 1.5 THK - 2x %%C76 CUTOUT, 8x %%C4.5 ON 71.5 SQ (80MM FANS)
; ---- notes ----
-TEXT -60,318 5 0 NOTES: 1. COLD FACE UP, INSTALL TILTED 15%%D TO GUTTER (HARVEST SHIM, SEE D-107).
-TEXT -60,308 5 0 2. COLD-SIDE DUCTED FAN GIVES 2 M/S FACE VELOCITY OVER PLATE (PER DESIGN CALC).
-TEXT -60,298 5 0 3. HOT SIDE: 4x EXTRUDED AL SINK 80x80x25 + 2x 80MM FANS, SIDE BLOWN.
-TEXT -60,288 5 0 4. CONTROL FLOORS PLATE AT +1%%DC (FROST GUARD). MODULE MASS 1.05 KG.
ZOOM E
EXPERT 0
FILEDIA 1
