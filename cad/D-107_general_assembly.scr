; ============================================================
; D-107  GENERAL ASSEMBLY - PV-CLEANING ROBOT
; TEC PV-CLEANING ROBOT, REE598 GRADUATION PROJECT
; UNITS MM. GEOMETRY 1:1, PLOT 1:2 ON A3
; VIEWS: SIDE ELEVATION + PLAN, ITEM LIST, EXPLODED ORDER
; BLANK LINES ARE DELIBERATE ENTER KEYSTROKES - KEEP THEM
; ============================================================
FILEDIA 0
EXPERT 3
OSMODE 0
INSUNITS 4
LTSCALE 2
-LINETYPE L HIDDEN acadiso.lin L CENTER acadiso.lin

-LAYER N OUTLINE,HIDDEN,CENTER,DIM,TEXT C 7 OUTLINE C 1 HIDDEN C 2 CENTER C 3 DIM C 4 TEXT L HIDDEN HIDDEN L CENTER CENTER S OUTLINE

DIMSCALE 2
DIMTXT 3.5
DIMASZ 2.5
DIMEXO 1
DIMEXE 1.5
DIMDEC 0
DIMZIN 8
; ---- sheet frame and title block ----
RECTANG -80,-130 900,640
RECTANG 600,-130 900,-70
LINE 600,-100 900,-100

LINE 760,-130 760,-70

CLAYER TEXT
-TEXT 610,-92 8 0 D-107  GENERAL ASSEMBLY
-TEXT 610,-122 5 0 TEC PV-CLEAN ROBOT - REE598 - 2026-06-12
-TEXT 770,-92 5 0 SCALE 1:2  SHEET A3
-TEXT 770,-122 5 0 UNITS MM - ISO 2768-m
; ============================================================
; SIDE ELEVATION. Ground y=0, rear of plate x=0, front x=400
; ============================================================
CLAYER OUTLINE
; ground line
LINE -60,0 520,0

; chassis plate 400 x 3, bottom at 15
RECTANG 0,15 400,18
; drive wheel DIA 60 at (80,30)
CIRCLE 80,30 30
CIRCLE 80,30 4
; motor bracket (ref) at rear
RECTANG 58,18 102,62
; tank 170 long x 100 high on plate (x 170..340)
RECTANG 170,18 340,118
; TEC sandwich on tank lid +5 standoffs (x 172..342, h 32)
RECTANG 172,123 342,155
; elx bay at rear (x 10..160, cover at 66)
CLAYER HIDDEN
RECTANG 10,18 160,66
CLAYER OUTLINE
; caster ball DIA 30 at (370,15)
CIRCLE 370,15 15
; brush arm from plate front to roller
LINE 400,18 425,55

LINE 400,15 430,50

; brush roller DIA 80 at (420,25) - 15 bristle interference
CIRCLE 420,25 40
CIRCLE 420,25 12.5
; spray bar above roller
CIRCLE 440,85 5
CLAYER CENTER
LINE 80,-12 80,72

LINE 420,-12 420,72

; ---- dims, side ----
CLAYER DIM
DIMLINEAR 0,15 400,15 200,-40
DIMLINEAR 0,0 460,0 230,-70
DIMLINEAR 340,0 340,155 540,80
DIMLINEAR 0,0 0,15 -30,8
; ---- balloons (text), side ----
CLAYER TEXT
-TEXT 0,80 5 0 1 CHASSIS PLATE D-101
-TEXT 30,68 5 0 2 BRACKET D-102
-TEXT 50,-18 5 0 3 WHEEL %%C60 (x2)
-TEXT 330,-18 5 0 4 CASTER (x2)
-TEXT 200,60 5 0 5 TANK D-105
-TEXT 200,162 5 0 6 TEC SANDWICH D-104
-TEXT 10,72 5 0 7 ELX BAY D-106
-TEXT 408,98 5 0 8 BRUSH D-103
-TEXT -60,-30 5 0 GROUND CLEARANCE 15 - BRISTLE INTERFERENCE 15 AT CONTACT
; ============================================================
; PLAN VIEW at y offset 240. Plate 400 x 300, brush front
; ============================================================
CLAYER OUTLINE
RECTANG F 10 0,240 400,540
; wheels in slots (hidden)
CLAYER HIDDEN
RECTANG F 0 50,250 110,270
RECTANG 50,510 110,530
; tank
RECTANG 170,275 340,505
; TEC sandwich over tank
RECTANG 172,305 342,475
; elx bay
RECTANG 10,350 160,450
CLAYER OUTLINE
; brush roller front, 250 wide centered (y 265..515)
RECTANG 410,265 460,515
; brush arms
LINE 400,262 410,267

LINE 400,518 410,513

CLAYER CENTER
LINE 80,230 80,550

LINE -15,390 475,390

; ---- dims, plan ----
CLAYER DIM
DIMLINEAR 0,240 0,540 -40,390
DIMLINEAR 410,265 410,515 490,390
DIMLINEAR 50,250 50,530 -64,390
; ---- callouts, plan ----
CLAYER TEXT
-TEXT 415,525 5 0 BRUSH SWATH 250
-TEXT -75,455 5 0 TRACK 260
-TEXT 130,548 5 0 PLAN VIEW - ENVELOPE 460 x 300 x 155 (195 WITH 15%%D HARVEST SHIM)
; ---- item list + exploded order ----
-TEXT -70,628 6 0 ITEM LIST (MASS BUDGET, TOTAL 6.00 KG):
-TEXT -70,614 5 0 1 CHASSIS PLATE AL6061 0.90 - 2 BRACKETS POM x2 0.12 - 2A GEARMOTORS x2 0.36
-TEXT -70,602 5 0 3 WHEELS x2 0.30 - 4 CASTERS 0.10 - 5 TANK+PUMP 0.40 - 5A WATER (MEAN FILL) 1.80
-TEXT -70,590 5 0 6 TEC SANDWICH 1.05 - 7 ELX BAY INCL BATTERY 0.37 - 8 BRUSH ASSY 0.60
-TEXT 430,628 6 0 EXPLODED / ASSEMBLY ORDER:
-TEXT 430,614 5 0 1 PLATE > 2 BRACKETS+MOTORS > 3 WHEELS > 4 CASTERS
-TEXT 430,602 5 0 > 5 TANK+PUMP > 6 TEC SANDWICH ON TANK LID
-TEXT 430,590 5 0 > 7 ELX BAY > 8 BRUSH ASSY. WIRE LAST, TEST PER REPORT CH.9
-TEXT -70,576 5 0 DESIGN BASIS: 6 KG ON 24%%D PANEL, F=32 N, TRACTION TORQUE 1.37 N-M TOTAL (0.69/WHEEL, MOTOR RATED 1.03 WITH SF 1.5)
ZOOM E
EXPERT 0
FILEDIA 1
