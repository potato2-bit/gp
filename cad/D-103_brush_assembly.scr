; ============================================================
; D-103  BRUSH ASSEMBLY - ROLLER, END BEARINGS, SPRAY BAR
; TEC PV-CLEANING ROBOT, REE598 GRADUATION PROJECT
; UNITS MM. GEOMETRY 1:1, PLOT 1:2 ON A3
; VIEWS: FRONT ELEVATION + END VIEW
; BLANK LINES ARE DELIBERATE ENTER KEYSTROKES - KEEP THEM
; ============================================================
FILEDIA 0
EXPERT 3
OSMODE 0
INSUNITS 4
LTSCALE 2
-LINETYPE L HIDDEN acadiso.lin L CENTER acadiso.lin

-LAYER N OUTLINE,HIDDEN,CENTER,DIM,TEXT C 7 OUTLINE C 1 HIDDEN C 2 CENTER C 3 DIM C 4 TEXT L HIDDEN HIDDEN L CENTER CENTER S OUTLINE

DIMSCALE 2
DIMTXT 3.5
DIMASZ 2.5
DIMEXO 1
DIMEXE 1.5
DIMDEC 1
DIMZIN 8
; ---- sheet frame and title block ----
RECTANG -60,-100 540,260
RECTANG 240,-100 540,-40
LINE 240,-70 540,-70

LINE 400,-100 400,-40

CLAYER TEXT
-TEXT 250,-62 8 0 D-103  BRUSH ASSEMBLY
-TEXT 250,-92 5 0 TEC PV-CLEAN ROBOT - REE598 - 2026-06-12
-TEXT 410,-62 5 0 SCALE 1:2  SHEET A3
-TEXT 410,-92 5 0 UNITS MM - ISO 2768-m
; ============================================================
; FRONT ELEVATION. Roller axis y=0, roller face x 0..250
; ============================================================
; roller microfibre DIA 80 x 250 face
CLAYER OUTLINE
RECTANG F 0 0,-40 250,40
; core tube DIA 25 (hidden)
CLAYER HIDDEN
LINE 0,-12.5 250,-12.5

LINE 0,12.5 250,12.5

; shaft DIA 8, extends 25 each side
CLAYER OUTLINE
RECTANG -25,-4 0,4
RECTANG 250,-4 275,4
; end bearing housings POM 40 x 40 x 12, at shaft ends
RECTANG -37,-20 -25,20
RECTANG 275,-20 287,20
; brush drive gearmotor JGA12 DIA 12 x 36 at right end (ref)
CLAYER HIDDEN
RECTANG 287,-6 323,6
; spray bar DIA 10 tube, 270 long, 60 above axis
CLAYER OUTLINE
RECTANG -10,55 260,65
; 5 nozzles at pitch 50, first at x=25
LINE 25,55 22,47

LINE 25,55 28,47

LINE 75,55 72,47

LINE 75,55 78,47

LINE 125,55 122,47

LINE 125,55 128,47

LINE 175,55 172,47

LINE 175,55 178,47

LINE 225,55 222,47

LINE 225,55 228,47

CLAYER CENTER
LINE -45,0 330,0

LINE 25,70 25,-50

LINE 225,70 225,-50

; ---- dims, front ----
CLAYER DIM
DIMLINEAR 0,-40 250,-40 125,-62
DIMLINEAR 25,55 75,55 50,80
DIMLINEAR 0,55 25,55 12,95
DIMLINEAR -25,-4 0,-4 -12,-30
DIMLINEAR -37,-20 -25,-20 -31,-44
DIMLINEAR 0,-40 0,40 -52,0
; ---- callouts, front ----
CLAYER TEXT
-TEXT 40,90 5 0 SPRAY BAR %%C10 PVC - 5 NOZZLES %%C1.0 AT PITCH 50
-TEXT 290,16 5 0 BRUSH GEARMOTOR (REF)
-TEXT 60,-75 5 0 MICROFIBRE ROLLER %%C80 x 250 ON %%C25 PVC CORE
-TEXT -55,28 5 0 BEARING HOUSING POM 40x40x12 (x2)
; ============================================================
; END VIEW at x offset 380
; ============================================================
CLAYER OUTLINE
CIRCLE 420,0 40
CIRCLE 420,0 12.5
CIRCLE 420,0 4
; bearing 608ZZ 8x22x7 (hidden)
CLAYER HIDDEN
CIRCLE 420,0 11
; spray bar end + nozzle fan toward panel ahead of roller
CLAYER OUTLINE
CIRCLE 440,60 5
LINE 437,56 425,35

LINE 443,56 455,35

CLAYER CENTER
LINE 372,0 468,0

LINE 420,-48 420,48

; ---- dims, end ----
CLAYER DIM
DIMDIAMETER 448.28,28.28 475,45
DIMDIAMETER 428.84,8.84 480,16
; ---- callouts, end ----
CLAYER TEXT
-TEXT 392,-60 5 0 END VIEW - 608ZZ BEARING 8x22x7 IN POM HOUSING
-TEXT 400,76 5 0 NOZZLE AIM 30%%D AHEAD OF ROLLER CONTACT
; ---- notes ----
-TEXT -50,246 5 0 NOTES: 1. ROLLER: MICROFIBRE SLEEVE ON PVC CORE %%C25, SHAFT STEEL %%C8 h6.
-TEXT -50,236 5 0 2. SPRAY LOW PRESSURE (DIAPHRAGM PUMP, D-105). NOZZLES %%C1.0 DRILLED, DEBURRED.
-TEXT -50,226 5 0 3. ARMS BOLT TO CHASSIS HOLES F (D-101) AT PITCH 20. BRUSH WIDTH 250 = CLEAN SWATH.
-TEXT -50,216 5 0 4. ASSEMBLY MASS 0.60 KG INCL DRIVE GEARMOTOR.
ZOOM E
EXPERT 0
FILEDIA 1
