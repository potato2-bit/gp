<?xml version="1.0" ?>
<!-- Solar-regenerated silica-gel atmospheric water harvester (AWH) — standalone unit.
     Components dimensioned around a 1 m^3 silica-gel bed. View with:
       gazebo gazebo/awh_description/awh_world.sdf
     Headless screenshot: bash gazebo/awh_description/make_shot.sh -->
<sdf version="1.6">
  <world name="awh_world">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.85 0.90 0.97 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="awh_unit">
      <static>true</static>

      <!-- base frame / skid -->
      <link name="base">
        <pose>0 0 0.05 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>2.4 1.4 0.1</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.33 1</diffuse></material>
        </visual>
      </link>

      <!-- silica-gel adsorption bed: vertical cylinder, ~1 m^3 (D=0.9 m, H=1.57 m) -->
      <link name="gel_bed">
        <pose>0 0 0.885 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.45</radius><length>1.57</length></cylinder></geometry>
          <material><ambient>0.10 0.35 0.75 1</ambient><diffuse>0.15 0.45 0.90 1</diffuse></material>
        </visual>
      </link>
      <!-- bed end caps -->
      <link name="bed_cap_top">
        <pose>0 0 1.69 0 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.47</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
      </link>
      <link name="bed_cap_bot">
        <pose>0 0 0.10 0 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.47</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
      </link>

      <!-- solar thermal collector: tilted dark glass panel (regeneration heat) -->
      <link name="solar_collector">
        <pose>1.05 0 1.15 0 0.52 0</pose>
        <visual name="v">
          <geometry><box><size>1.5 1.2 0.08</size></box></geometry>
          <material><ambient>0.03 0.03 0.08 1</ambient><diffuse>0.05 0.05 0.15 1</diffuse>
            <specular>0.4 0.4 0.6 1</specular></material>
        </visual>
      </link>

      <!-- condenser: finned box where desorbed vapour is cooled to liquid water -->
      <link name="condenser">
        <pose>-1.0 0 0.7 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.35 0.8 1.0</size></box></geometry>
          <material><ambient>0.70 0.80 0.88 1</ambient><diffuse>0.80 0.90 0.96 1</diffuse></material>
        </visual>
      </link>

      <!-- collection tank under the condenser -->
      <link name="tank">
        <pose>-1.0 0 0.18 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.4 0.85 0.25</size></box></geometry>
          <material><ambient>0.10 0.45 0.55 1</ambient><diffuse>0.15 0.60 0.70 1</diffuse></material></visual>
      </link>

      <!-- fan / blower driving the air through the bed -->
      <link name="fan">
        <pose>0 0.75 0.4 1.5708 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- ducts: bed <-> condenser, bed <-> fan -->
      <link name="duct_cond">
        <pose>-0.55 0 1.2 0 1.5708 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
      <link name="duct_fan">
        <pose>0 0.45 0.4 1.5708 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
