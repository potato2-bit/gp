<?xml version="1.0"?>
<!--
  panel_world.sdf - 2 m2 PV panel at 24 deg tilt, REE598 pvbot project.
  Panel: 2.0 m (slope) x 1.0 m (width) x 0.04 m glass-faced box, pitched
  24 deg (0.41888 rad) about Y, raised so the low edge nearly touches the
  ground. Friction set glass-like (mu 0.6) per ROS2_ARCHITECTURE.tex.
  Loads in Gazebo Classic 11 and Gazebo Harmonic (gz sim).
-->
<sdf version="1.7">
  <world name="panel_world">

    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.75 0.6 1</ambient>
            <diffuse>0.8 0.75 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2 m2 panel: 2.0 x 1.0 face, tilted 24 deg about +Y.
         Center height 0.45 m puts the low edge ~0.04 m off the ground,
         resting on the frame posts below. -->
    <model name="pv_panel">
      <static>true</static>
      <pose>0 0 0.45 0 -0.41888 0</pose>
      <link name="panel">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>0.6</mu><mu2>0.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.08 0.20 1</ambient>
            <diffuse>0.08 0.12 0.30 1</diffuse>
            <specular>0.6 0.6 0.7 1</specular>
          </material>
        </visual>
      </link>
      <!-- support posts (visual context only) -->
      <link name="post_high">
        <pose>-0.85 0 -0.43 0.41888 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.06 1.0 0.06</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <joint name="j1" type="fixed">
        <parent>panel</parent><child>post_high</child>
      </joint>
    </model>

  </world>
</sdf>
