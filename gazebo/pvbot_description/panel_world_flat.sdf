<?xml version="1.0"?>
<!--
  panel_world_flat.sdf - 2 m2 PV panel mounted FLAT on a low frame so the
  diff-drive crawler can execute the full boustrophedon without sliding.

  Why flat: a free-driving 6 kg robot cannot get traction on a 24 deg glass
  face in simulation - it slides down under gravity (exactly the "only moves
  down and stops" behaviour). The deployment tilt (24-26 deg) is shown as a
  static side view in the report and the offline GIF; this world is for the
  motion + subsystem demo, where the robot must stay on the panel and clean it.

  Panel: 2.0 x 1.0 x 0.04 box, top surface at z = 0.12, on four posts. Low
  curbs around the rim catch any overshoot so the robot never falls off.
  Friction is set so the wheels (mu 0.9) grip the panel (mu 0.8).
-->
<sdf version="1.6">
  <world name="panel_world_flat">

    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.75 0.72 0.62 1</ambient><diffuse>0.75 0.72 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <!-- panel centre at (1.0, 0.5); face spans x in [0,2], y in [0,1] -->
    <model name="pv_panel">
      <static>true</static>
      <pose>1.0 0.5 0.10 0 0 0</pose>
      <link name="panel">
        <collision name="face_c"><pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>2.0 1.0 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <visual name="face_v"><pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>2.0 1.0 0.04</size></box></geometry>
          <material><ambient>0.20 0.24 0.30 1</ambient><diffuse>0.22 0.27 0.34 1</diffuse>
            <specular>0.4 0.4 0.5 1</specular></material></visual>
        <visual name="l1"><pose>-0.9 -0.4 -0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.10</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <visual name="l2"><pose> 0.9 -0.4 -0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.10</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <visual name="l3"><pose>-0.9  0.4 -0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.10</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
        <visual name="l4"><pose> 0.9  0.4 -0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.10</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>

    <!-- low curbs around the panel rim (safety catch) -->
    <model name="curbs"><static>true</static>
      <link name="link">
        <collision name="cx0"><pose>0.0 0.5 0.145 0 0 0</pose><geometry><box><size>0.03 1.06 0.05</size></box></geometry></collision>
        <visual    name="vx0"><pose>0.0 0.5 0.145 0 0 0</pose><geometry><box><size>0.03 1.06 0.05</size></box></geometry>
          <material><ambient>0.45 0.32 0.18 1</ambient></material></visual>
        <collision name="cx2"><pose>2.0 0.5 0.145 0 0 0</pose><geometry><box><size>0.03 1.06 0.05</size></box></geometry></collision>
        <visual    name="vx2"><pose>2.0 0.5 0.145 0 0 0</pose><geometry><box><size>0.03 1.06 0.05</size></box></geometry>
          <material><ambient>0.45 0.32 0.18 1</ambient></material></visual>
        <collision name="cy0"><pose>1.0 0.0 0.145 0 0 0</pose><geometry><box><size>2.06 0.03 0.05</size></box></geometry></collision>
        <visual    name="vy0"><pose>1.0 0.0 0.145 0 0 0</pose><geometry><box><size>2.06 0.03 0.05</size></box></geometry>
          <material><ambient>0.45 0.32 0.18 1</ambient></material></visual>
        <collision name="cy1"><pose>1.0 1.0 0.145 0 0 0</pose><geometry><box><size>2.06 0.03 0.05</size></box></geometry></collision>
        <visual    name="vy1"><pose>1.0 1.0 0.145 0 0 0</pose><geometry><box><size>2.06 0.03 0.05</size></box></geometry>
          <material><ambient>0.45 0.32 0.18 1</ambient></material></visual>
      </link>
    </model>

  </world>
</sdf>
