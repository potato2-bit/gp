<?xml version="1.0"?>
<!--
  panel_world_tilt.sdf - 2 m2 PV panel at the 24 deg DEPLOYMENT tilt, with
  guide rails so the crawler stays on it. This is the real configuration: the
  robot cleans on the tilted glass, not on a flat mock-up.

  Two things make it work where the bare tilt failed:
    1. grippy cleaning treads - panel friction mu = 0.9 (> tan 24 = 0.45), so
       the diff-drive velocity controller holds station against gravity instead
       of sliding. This is the gravity-hold: a velocity setpoint of zero locks
       the wheels, and the traction budget (needs ~0.36 N m/wheel to hold,
       limit is 1.03) has headroom.
    2. guide rails along all four edges (the panel frame lip) - a physical
       constraint that catches any cross-slope drift. The two rails running up
       the slope are the rail-guidance; the robot rides between them.

  Coverage runs as horizontal-friendly strokes up/down the fall line with
  cross-slope steps (pvbot_coverage.py), so the wheels never have to fight a
  large gravity component during a turn.
-->
<sdf version="1.6">
  <world name="panel_world_tilt">

    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- state plugin: provides /gazebo/set_entity_state so the rail driver can
         glide the carriage smoothly along the rail at 30 Hz -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <!-- camera on the GLASS side (the panel face points toward -x and up), so
         the carriage is clearly seen riding ON the glass, not behind the panel -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-1.0 -2.3 2.3 0 0.62 1.13</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.75 0.72 0.62 1</ambient><diffuse>0.75 0.72 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <!-- panel tilted -24 deg about Y. Local x = up/down slope (+-1.0 m),
         local y = cross-slope (+-0.5 m). Children inherit the tilt. -->
    <model name="pv_panel">
      <static>true</static>
      <pose>0 0 0.50 0 -0.41888 0</pose>
      <link name="panel">
        <collision name="face_c">
          <geometry><box><size>2.0 1.0 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="face_v">
          <geometry><box><size>2.0 1.0 0.04</size></box></geometry>
          <material><ambient>0.20 0.24 0.30 1</ambient><diffuse>0.22 0.27 0.34 1</diffuse>
            <specular>0.4 0.4 0.5 1</specular></material></visual>

        <!-- TWO GUIDE RAILS running up the slope (local x). The gantry carriage
             rides between them; its wheels run just inside at y = +/-0.45. -->
        <collision name="rail_yp_c"><pose>0 0.51 0.045 0 0 0</pose><geometry><box><size>2.04 0.04 0.09</size></box></geometry></collision>
        <visual    name="rail_yp_v"><pose>0 0.51 0.045 0 0 0</pose><geometry><box><size>2.04 0.04 0.09</size></box></geometry>
          <material><ambient>0.30 0.33 0.40 1</ambient><diffuse>0.35 0.40 0.48 1</diffuse><specular>0.5 0.5 0.6 1</specular></material></visual>
        <collision name="rail_yn_c"><pose>0 -0.51 0.045 0 0 0</pose><geometry><box><size>2.04 0.04 0.09</size></box></geometry></collision>
        <visual    name="rail_yn_v"><pose>0 -0.51 0.045 0 0 0</pose><geometry><box><size>2.04 0.04 0.09</size></box></geometry>
          <material><ambient>0.30 0.33 0.40 1</ambient><diffuse>0.35 0.40 0.48 1</diffuse><specular>0.5 0.5 0.6 1</specular></material></visual>
        <!-- rack strip for the rack-and-pinion drive, along the +y rail (visual) -->
        <visual name="rack_v"><pose>0 0.47 0.028 0 0 0</pose><geometry><box><size>2.0 0.018 0.030</size></box></geometry>
          <material><ambient>0.13 0.13 0.14 1</ambient></material></visual>
        <!-- end stops at the top and bottom of travel -->
        <collision name="rail_xp_c"><pose>1.01 0 0.04 0 0 0</pose><geometry><box><size>0.03 1.06 0.06</size></box></geometry></collision>
        <visual    name="rail_xp_v"><pose>1.01 0 0.04 0 0 0</pose><geometry><box><size>0.03 1.06 0.06</size></box></geometry>
          <material><ambient>0.45 0.32 0.18 1</ambient></material></visual>
        <collision name="rail_xn_c"><pose>-1.01 0 0.04 0 0 0</pose><geometry><box><size>0.03 1.06 0.06</size></box></geometry></collision>
        <visual    name="rail_xn_v"><pose>-1.01 0 0.04 0 0 0</pose><geometry><box><size>0.03 1.06 0.06</size></box></geometry>
          <material><ambient>0.45 0.32 0.18 1</ambient></material></visual>
      </link>

    </model>

    <!-- support frame: clean vertical legs holding the high edge of the tilted
         panel (world coords, so they stand straight up). Panel high edge sits
         at world x ~ +0.9, z ~ 0.9; the low edge rests near the ground. -->
    <model name="panel_frame"><static>true</static>
      <link name="legs">
        <visual name="hi_l"><pose>0.88 0.42 0.44 0 0 0</pose><geometry><box><size>0.05 0.05 0.88</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient></material></visual>
        <visual name="hi_r"><pose>0.88 -0.42 0.44 0 0 0</pose><geometry><box><size>0.05 0.05 0.88</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient></material></visual>
        <visual name="hi_beam"><pose>0.88 0 0.86 0 0 0</pose><geometry><box><size>0.05 0.92 0.05</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient></material></visual>
        <visual name="lo_l"><pose>-0.88 0.42 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.10</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient></material></visual>
        <visual name="lo_r"><pose>-0.88 -0.42 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.10</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient></material></visual>
      </link>
    </model>

    <!-- ===================================================================
         TEC ATMOSPHERIC-WATER-GENERATION DOCK (stationary).
         In the finalized residential design the thermoelectric condenser is
         NOT on the carriage (it would push the carriage past 8 kg). It lives
         here, at the BOTTOM of the rail (world x ~= -1.0), as a fixed dock that
         the carriage returns to between cleans for a water top-up and a battery
         top-up charge. Sources: ELECTRICAL_DESIGN.tex (TEC moved to dock,
         1.05 kg off the carriage; dock 48 V string bank, EPever MPPT);
         MARKET_PARTS_BUYLIST.md (TEC1-12706 tiles, 4 bench / 38 NAC; 120 mm
         fans; IRLB4030 string switches); CAD D-104 (cold-plate sandwich,
         170x170 plate, 4x 80x80x25 finned sinks, 2 fans).

         Shown here: a representative 2x4 = 8-tile cold-plate array (the bench
         build is 2x2 = 4 tiles; the residential NAC bank scales to 38 tiles in
         9 series-quads + 1 pair), four finned hot-side heat sinks, two fans, a
         condensate collection tank, and a power box (MPPT + dock battery +
         PV-tie). Static, so it never moves under physics. -->
    <model name="awg_dock">
      <static>true</static>
      <pose>-1.05 0 0 0 0 0</pose>
      <link name="dock">

        <!-- dock base / enclosure plinth -->
        <visual name="plinth"><pose>0 0 0.06 0 0 0</pose>
          <geometry><box><size>0.40 0.70 0.12</size></box></geometry>
          <material><ambient>0.22 0.24 0.27 1</ambient><diffuse>0.26 0.28 0.32 1</diffuse></material></visual>

        <!-- Al cold plate (170x170 per tile module; here a wide bench across the array) -->
        <visual name="cold_plate"><pose>-0.06 0 0.135 0 0 0</pose>
          <geometry><box><size>0.20 0.40 0.006</size></box></geometry>
          <material><ambient>0.55 0.78 0.88 1</ambient><diffuse>0.60 0.85 0.95 1</diffuse><specular>0.5 0.6 0.7 1</specular></material></visual>

        <!-- TEC tile grid: representative 2 rows x 4 columns = 8 tiles on the cold face.
             40x40 mm TEC1-12706 tiles at 85 mm pitch. (Bench=4, NAC bank=38.) -->
        <visual name="tile_00"><pose>-0.06  0.150 0.139 0 0 0</pose><geometry><box><size>0.040 0.040 0.004</size></box></geometry><material><ambient>0.12 0.05 0.05 1</ambient></material></visual>
        <visual name="tile_01"><pose>-0.06  0.050 0.139 0 0 0</pose><geometry><box><size>0.040 0.040 0.004</size></box></geometry><material><ambient>0.12 0.05 0.05 1</ambient></material></visual>
        <visual name="tile_02"><pose>-0.06 -0.050 0.139 0 0 0</pose><geometry><box><size>0.040 0.040 0.004</size></box></geometry><material><ambient>0.12 0.05 0.05 1</ambient></material></visual>
        <visual name="tile_03"><pose>-0.06 -0.150 0.139 0 0 0</pose><geometry><box><size>0.040 0.040 0.004</size></box></geometry><material><ambient>0.12 0.05 0.05 1</ambient></material></visual>
        <visual name="tile_10"><pose>-0.02  0.150 0.139 0 0 0</pose><geometry><box><size>0.040 0.040 0.004</size></box></geometry><material><ambient>0.12 0.05 0.05 1</ambient></material></visual>
        <visual name="tile_11"><pose>-0.02  0.050 0.139 0 0 0</pose><geometry><box><size>0.040 0.040 0.004</size></box></geometry><material><ambient>0.12 0.05 0.05 1</ambient></material></visual>
        <visual name="tile_12"><pose>-0.02 -0.050 0.139 0 0 0</pose><geometry><box><size>0.040 0.040 0.004</size></box></geometry><material><ambient>0.12 0.05 0.05 1</ambient></material></visual>
        <visual name="tile_13"><pose>-0.02 -0.150 0.139 0 0 0</pose><geometry><box><size>0.040 0.040 0.004</size></box></geometry><material><ambient>0.12 0.05 0.05 1</ambient></material></visual>

        <!-- hot-side finned heat sinks: 4x 80x80x25 mm extruded sinks above the tiles -->
        <visual name="sink_0"><pose>-0.04  0.165 0.175 0 0 0</pose><geometry><box><size>0.080 0.080 0.025</size></box></geometry><material><ambient>0.78 0.80 0.83 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
        <visual name="sink_1"><pose>-0.04  0.055 0.175 0 0 0</pose><geometry><box><size>0.080 0.080 0.025</size></box></geometry><material><ambient>0.78 0.80 0.83 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
        <visual name="sink_2"><pose>-0.04 -0.055 0.175 0 0 0</pose><geometry><box><size>0.080 0.080 0.025</size></box></geometry><material><ambient>0.78 0.80 0.83 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
        <visual name="sink_3"><pose>-0.04 -0.165 0.175 0 0 0</pose><geometry><box><size>0.080 0.080 0.025</size></box></geometry><material><ambient>0.78 0.80 0.83 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
        <!-- fin lines drawn on the sinks for read -->
        <visual name="fins_a"><pose>-0.04  0.11 0.195 0 0 0</pose><geometry><box><size>0.080 0.30 0.002</size></box></geometry><material><ambient>0.6 0.62 0.66 1</ambient></material></visual>

        <!-- two 120 mm axial fans blowing through the fins -->
        <visual name="fan_l"><pose>0.02  0.11 0.200 0 1.5708 0</pose><geometry><cylinder><radius>0.060</radius><length>0.025</length></cylinder></geometry><material><ambient>0.20 0.20 0.23 1</ambient></material></visual>
        <visual name="fan_r"><pose>0.02 -0.11 0.200 0 1.5708 0</pose><geometry><cylinder><radius>0.060</radius><length>0.025</length></cylinder></geometry><material><ambient>0.20 0.20 0.23 1</ambient></material></visual>

        <!-- condensate collection tank at the dock base -->
        <visual name="cond_tank"><pose>0.12 0.20 0.10 0 0 0</pose><geometry><box><size>0.14 0.22 0.16</size></box></geometry>
          <material><ambient>0.18 0.40 0.78 0.55</ambient><diffuse>0.20 0.45 0.85 0.55</diffuse></material></visual>
        <!-- condensate drain tube from the cold plate down to the tank -->
        <visual name="drain"><pose>0.04 0.20 0.16 0 0 0</pose><geometry><cylinder><radius>0.006</radius><length>0.10</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>

        <!-- power box: EPever MPPT + dock LFP bank + PV-tie / 48 V string switches -->
        <visual name="power_box"><pose>0.12 -0.20 0.12 0 0 0</pose><geometry><box><size>0.16 0.24 0.18</size></box></geometry>
          <material><ambient>0.15 0.17 0.20 1</ambient><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
        <visual name="mppt_face"><pose>0.205 -0.20 0.14 0 0 0</pose><geometry><box><size>0.004 0.14 0.08</size></box></geometry>
          <material><ambient>0.10 0.55 0.30 1</ambient></material></visual>

        <!-- a small PV-tie panel cue feeding the dock (the dock runs off PV via MPPT) -->
        <visual name="pv_tie"><pose>-0.14 -0.20 0.30 0 -0.4 0</pose><geometry><box><size>0.30 0.22 0.012</size></box></geometry>
          <material><ambient>0.10 0.12 0.22 1</ambient><diffuse>0.12 0.15 0.28 1</diffuse><specular>0.4 0.4 0.5 1</specular></material></visual>

        <!-- collision: just the plinth so the carriage end-of-travel can rest near it -->
        <collision name="plinth_c"><pose>0 0 0.06 0 0 0</pose>
          <geometry><box><size>0.40 0.70 0.12</size></box></geometry></collision>
      </link>
    </model>

    <!-- headless screenshot camera sensor -->
    <model name="shot_camera">
      <static>true</static>
      <pose>-1.0 -2.3 2.3 0 0.62 1.13</pose>
      <link name="link">
        <sensor name="shot_cam" type="camera">
          <always_on>1</always_on>
          <update_rate>2</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>1600</width><height>1000</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>100</far></clip>
            <save enabled="true"><path>/tmp/gzshot</path></save>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
