{"nodes": [{"id": "project_awh_benban_numbers_cost_quality", "label": "Benban Case Study: Numerical Comparison, Water Quality, Efficiency, and Cost", "file_type": "document", "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_awh_benban_numbers_cost_quality_cleaning_water_demand_model", "label": "Cleaning Water Demand Model (V_year = w A N_clean (1+f_margin))", "file_type": "concept", "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With w=1.8 L/m2/event, N_clean=18/yr, f_margin=0.25 and a 200 MW block (9.3e5 m2), annual demand is 3.77e4 m3/yr (~103,200 kg/day); parameters live in project_inputs.yaml as the single source of truth."}, {"id": "project_awh_benban_numbers_cost_quality_specific_energy_consumption", "label": "Specific Energy Consumption (SEC_el = E_el / m_w, kWh/kg)", "file_type": "concept", "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single shared metric so all AWH families are compared on the same water mass; literature anchors: absorption 0.38, cooling condensation 0.42, adsorption 1.16, TEC band 2.0/6.0/12.0 kWh/kg."}, {"id": "project_awh_benban_numbers_cost_quality_levelized_cost_of_water", "label": "Levelized Cost of Water (LCOW)", "file_type": "concept", "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LCOW = CRF*CAPEX/V_year + rho*pi*SEC + O&M/V_year; separates a CAPEX-dominated term (scales 1/A) from an SEC-dominated term (scale-independent), which is what makes the technology ranking flip with PV asset size."}, {"id": "project_awh_benban_numbers_cost_quality_vcr_awg", "label": "Vapor-Compression Refrigeration (VCR) Atmospheric Water Generator", "file_type": "concept", "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mature AWG family with the best kWh-per-kg among electrically driven condensers; wins at Benban scale (LCOW ~22.4 vs TEC ~85 USD/m3) but requires inverter AC, refrigerant handling, and compressor overhaul at 5-10 years."}, {"id": "project_awh_benban_numbers_cost_quality_water_quality_targets", "label": "PV Rinse Water Quality Targets (TDS, hardness, pH, particles)", "file_type": "concept", "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wet cleaning is spotting-sensitive: dissolved salts leave residues, so final rinse targets low hundreds of mg/L TDS or below (~50-100 mg/L with RO/demineralisation), near-neutral pH for frame/seal compatibility, and filtration to avoid scratching."}, {"id": "project_awh_benban_numbers_cost_quality_mof_sorption", "label": "MOF Sorption AWH (advanced sorbents for low RH)", "file_type": "concept", "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_awh_benban_numbers_cost_quality_diurnal_psychrometrics", "label": "Diurnal Psychrometric Cycle Dominance in Desert AWH Sizing", "file_type": "rationale", "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Average RH misleads AWH sizing in deserts: midday is hot/dry while night and morning offer better condensation windows, so design must use hourly psychrometrics, not monthly RH means."}], "edges": [{"source": "project_awh_benban_numbers_cost_quality", "target": "project_awh_benban_numbers_cost_quality_cleaning_water_demand_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality", "target": "project_awh_benban_numbers_cost_quality_specific_energy_consumption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality", "target": "project_awh_benban_numbers_cost_quality_levelized_cost_of_water", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality", "target": "project_awh_benban_numbers_cost_quality_vcr_awg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality", "target": "project_awh_benban_numbers_cost_quality_water_quality_targets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality", "target": "project_awh_benban_numbers_cost_quality_mof_sorption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality", "target": "project_awh_benban_numbers_cost_quality_diurnal_psychrometrics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality", "target": "egypt_pv_inventory_and_tec_small_scale_benban_solar_park", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality_mof_sorption", "target": "feng_et_al_2022_recent_development_of_atmospheric_water_harvesting_materials_a_review", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}, {"source": "project_awh_benban_numbers_cost_quality_levelized_cost_of_water", "target": "project_awh_benban_numbers_cost_quality_specific_energy_consumption", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project_awh_benban_numbers_cost_quality.pdf", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "tec_vs_vcr_economic_comparison", "label": "TEC vs VCR Techno-Economic Comparison Framework", "nodes": ["main_report_tec_awh", "project_awh_benban_numbers_cost_quality_vcr_awg", "project_awh_benban_numbers_cost_quality_specific_energy_consumption", "project_awh_benban_numbers_cost_quality_levelized_cost_of_water", "egypt_pv_inventory_and_tec_small_scale_lcow_breakeven"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "project_awh_benban_numbers_cost_quality.pdf"}]}