{"nodes": [{"id": "final_short_report", "label": "Final Short Report: Autonomous Thermoelectric Atmospheric-Water PV-Cleaning Robot", "file_type": "document", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Rahma El-Hamouly", "contributor": null}, {"id": "tec1_12706", "label": "TEC1-12706 Peltier Module (130 EGP, alpha=0.0513 V/K, R=2.00 ohm, K=0.546 W/K)", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most widely stocked Peltier module in Egypt; catalogue maxima Imax=6.0 A, Umax=15.4 V, dTmax=66 K give Qc,max=56.4 W; cheap, solid-state, and small enough to ride on a robot."}, {"id": "smart_night_only_strategy", "label": "Smart Night-Only Harvesting Strategy (5 K Condensation Margin)", "file_type": "rationale", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Harvest only in hours when the plate can be held 5 K below dew point within Imax; raises mean COP from 0.78 to 1.44 and cuts specific energy consumption by 78% at the cost of 34% of the water; 5 K margin maximizes annual yield since water is the binding constraint."}, {"id": "one_robot_per_array", "label": "One Robot per Array Architecture", "file_type": "rationale", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full water self-sufficiency at 1 L/day costs 5.32 kWh/day and 5.34 m2 of dedicated PV, but a cleaned 2 m2 panel makes only ~2 kWh/day, so a self-powered one-robot-per-panel loop is infeasible; a high panel-to-robot ratio amortises the 1147 Wp supply and AWG hardware."}, {"id": "seasonal_reservoir_storage", "label": "Seasonal Reservoir Storage of Harvested Water", "file_type": "rationale", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yield concentrates October-March (peak 4.5 L/day in November) and collapses June-September when dew points sit near 6 C at very low humidity; banking the winter surplus carries cleaning through the dead season, making AWG water a seasonal supplementary source, not on-demand."}, {"id": "tec_69_tile_array", "label": "69-Tile TEC Array (1.011 L/day, 4.16 kWh/L Thermoelectric)", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One tile yields 5.35 L/yr (14.65 g/day) for 22.25 kWh/yr at mean COP 1.44; 69 tiles meet the 1 L/day target; system draws 5.32 kWh/day (TEC 79%, fans 20%), needing 1147 Wp PV and a 698 Ah 12 V battery."}, {"id": "boustrophedon_coverage_path", "label": "Boustrophedon (Lawn-Mower) Coverage Path", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "robot_control_state_machine", "label": "Supervisory State Machine (Idle-Harvest-Store-Clean-Dock on ESP32)", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cold_plate_pid_control", "label": "Cold-Plate PID Control of TEC Current (Anti-Windup at Imax=6 A)", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_pivot_2026_04_24", "label": "Project Pivot of 24 April 2026 (Utility AWH Study to Autonomous Robot)", "file_type": "rationale", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Benban numbers showed TEC cannot compete with VCR at utility scale but proved AWH physics works in arid Egypt (RH 25-55%, 25-42 C); at robot scale the comparison inverts, so the Benban work is retained as feasibility evidence in the methodology and the autonomous robot becomes the deliverable."}, {"id": "four_tile_bench_prototype", "label": "4-Tile Bench Prototype (~59 g/day expected, ~5760 EGP)", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because the model is per-tile linear, 4 tiles validate the physics and the 69-tile full-scale numbers follow by multiplication; bench runs from a mains 12 V supply since battery/PV/drive are not needed to validate condensation and control."}, {"id": "eight_review_flags", "label": "Eight Open Engineering Review Flags on the REE598 Proposal", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags include: Table 6.1/6.2 energy contradiction (payback ~9 yr not 1.9), SEC 0.927 kWh/L optimism superseded by coupled-solver 4.16 kWh/L, hot-side temperature must be solved not assumed (Th~50 C), optimistic 0.5 K/W heat-sink resistance, undersized Scale-B battery (2.5 kWh needed), unrealistic pack price (~900 USD unit total), infeasible Scale-C gantry replaced by fleet, and a 5 L condensate tank that cannot hold one 82.8 L cleaning event."}, {"id": "egypt_vision_2030", "label": "Egypt Vision 2030 Sustainable Development Strategy", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": "https://www.mped.gov.eg/IndicatorsDetails.aspx?id=1107&lang=en", "captured_at": null, "author": null, "contributor": null}, {"id": "tec_awh_cleaning_robot", "label": "Autonomous TEC Atmospheric-Water PV-Cleaning Robot (Project Deliverable)", "file_type": "concept", "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 6 kg differential-drive crawler that condenses its own distilled cleaning water (conductivity <10 uS/cm, no mineral streaking) from night air using TEC tiles, eliminating trucked-water logistics; cleans with 3.6 L per event (1.8 L/m2) supporting 102.5 events/yr."}], "edges": [{"source": "final_short_report", "target": "tec_awh_cleaning_robot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "weight": 1.0}, {"source": "final_short_report", "target": "tec1_12706", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "weight": 1.0}, {"source": "final_short_report", "target": "tec_69_tile_array", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "weight": 1.0}, {"source": "final_short_report", "target": "smart_night_only_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "weight": 1.0}, {"source": "final_short_report", "target": "one_robot_per_array", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "weight": 1.0}, {"source": "final_short_report", "target": "seasonal_reservoir_storage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "FINAL_SHORT_REPORT.pdf", "source_location": null, "weight": 1.0}, {"source": "final_short_report", "target": "four_tile_bench_prototype", "relation": "references", "confidence": "EXTRACTED", "co