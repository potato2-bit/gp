{"nodes": [{"id": "graphify_skill_graphify", "label": "Graphify Knowledge Graph Pipeline", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns any folder of code, docs, papers, images, or video into a persistent, queryable knowledge graph with an honest EXTRACTED/INFERRED/AMBIGUOUS audit trail; community detection surfaces cross-document connections users would not think to ask about."}, {"id": "graphify_skill_community_detection", "label": "Community Detection and Labeling", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": ".claude/skills/graphify/SKILL.md Step 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_skill_god_nodes", "label": "God Nodes Analysis", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": ".claude/skills/graphify/SKILL.md Step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_skill_ast_extraction", "label": "Structural AST Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": ".claude/skills/graphify/SKILL.md Step 3 Part A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic and free; runs in parallel with LLM semantic extraction because the two operate on different file types, saving 5-15s on large corpora."}, {"id": "graphify_skill_semantic_extraction", "label": "Parallel Semantic Extraction Subagents", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": ".claude/skills/graphify/SKILL.md Step 3 Part B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent tool dispatch is mandatory because reading files one-by-one is 5-10x slower; all subagents must be dispatched in a single message to actually run in parallel, and must be general-purpose (not Explore) so they can write chunk files to disk."}, {"id": "graphify_skill_extraction_cache", "label": "Semantic Extraction Cache", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": ".claude/skills/graphify/SKILL.md Step B0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checked before dispatching any subagents so already-extracted files cost zero tokens on re-runs."}, {"id": "graphify_skill_honesty_rules", "label": "Graphify Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": ".claude/skills/graphify/SKILL.md Honesty Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge, never hide cohesion scores, always show token cost; uncertain relationships are marked AMBIGUOUS rather than omitted, preserving an honest audit trail."}], "edges": [{"source": "graphify_skill_graphify", "target": "references_extraction_spec_subagent_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part B", "weight": 1.0}, {"source": "graphify_skill_graphify", "target": "references_query_graph_query", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "For /graphify query", "weight": 1.0}, {"source": "graphify_skill_graphify", "target": "references_update_incremental_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "For --update and --cluster-only", "weight": 1.0}, {"source": "graphify_skill_graphify", "target": "references_update_cluster_only", "rel