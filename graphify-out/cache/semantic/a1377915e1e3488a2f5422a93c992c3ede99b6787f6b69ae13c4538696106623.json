{"nodes": [{"id": "main_report", "label": "Main Report - Autonomous Thermoelectric-Based AWH Robot for PV Panel Cleaning", "file_type": "document", "source_file": "main_report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Rahma El Hamouly", "contributor": null}, {"id": "main_report_tec_awh", "label": "TEC (Peltier) Atmospheric Water Harvesting", "file_type": "concept", "source_file": "main_report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the robot's water source despite SEC of 2-12 kWh/kg (vs VCR 0.42) because it matches the DC power architecture of a PV-battery system, has no moving parts or refrigerant, responds instantly to intermittent PV power, and scales down to sub-litre daily duties where no commercial VCR exists."}, {"id": "main_report_autonomous_pv_cleaning_robot", "label": "Autonomous PV Cleaning Robot", "file_type": "concept", "source_file": "main_report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No commercially available autonomous cleaner integrates its own water supply; the robot harvests water overnight, self-charges from the panels it cleans, and reduces maintenance to filter changes every weeks-months."}, {"id": "main_report_three_deployment_scales", "label": "Three Deployment Scales (A: 80 W street lamp, B: 10 kWp commercial rooftop, C: 200 kWp industrial)", "file_type": "concept", "source_file": "main_report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single robot geometry cannot serve all PV applications because orientation, tilt, frame structure, array footprint, and water demand (0.15 / 3.0 / 40 L per day) differ significantly across scales."}, {"id": "main_report_soiling_losses_egypt", "label": "PV Dust Soiling in Egypt and MENA", "file_type": "concept", "source_file": "main_report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soiling losses of 0.3-2.0 %/day (15-40 % monthly), with khamsin storms costing 5-10 % in a single day, motivate regular wet cleaning; economically optimal cleaning interval is 7-21 days."}, {"id": "main_report_benban_climate_reference", "label": "Benban as Worst-Case Climate Validation Reference", "file_type": "rationale", "source_file": "main_report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Benban is not the deployment target; its arid microclimate (low RH, high ambient, large diurnal swing) is the most thermodynamically demanding case for a TEC condenser - adequate yield there guarantees performance in milder coastal/Delta new cities."}], "edges": [{"source": "main_report", "target": "main_report_tec_awh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "main_report.pdf", "source_location": null, "weight": 1.0}, {"source": "main_report", "target": "main_report_autonomous_pv_cleaning_robot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "main_report.pdf", "source_location": null, "weight": 1.0}, {"source": "main_report", "target": "main_report_three_deployment_scales", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "main_report.pdf", "source_location": null, "weight": 1.0}, {"source": "main_report", "target": "main_report_soiling_losses_egypt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "main_report.pdf", "source_location": null, "weight": 1.0}, {"source": "main_report", "target": "main_report_benban_climate_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "main_report.pdf", "source_location": null, "w