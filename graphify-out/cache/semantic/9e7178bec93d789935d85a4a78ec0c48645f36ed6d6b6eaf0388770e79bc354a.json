{"nodes": [{"id": "egypt_pv_inventory_and_tec_small_scale", "label": "Egyptian Solar PV Inventory and Small-Scale TEC Feasibility", "file_type": "document", "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "egypt_pv_inventory_and_tec_small_scale_benban_solar_park", "label": "Benban Solar Park (Aswan, 1465 MW DC, 24.45N 32.75E)", "file_type": "concept", "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "source_url": "https://en.wikipedia.org/wiki/Benban_Solar_Park", "captured_at": null, "author": null, "contributor": null}, {"id": "egypt_pv_inventory_and_tec_small_scale_kom_ombo_pv", "label": "ACWA Power Kom Ombo PV (200 MW AC, Aswan)", "file_type": "concept", "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "source_url": "https://acwapower.com/en/projects/kom-ombo-pv/", "captured_at": null, "author": null, "contributor": null}, {"id": "egypt_pv_inventory_and_tec_small_scale_egyptera", "label": "EgyptERA (Egyptian Electric Utility and Consumer Protection Regulatory Agency)", "file_type": "concept", "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "source_url": "https://www.egyptera.org/en/", "captured_at": null, "author": null, "contributor": null}, {"id": "egypt_pv_inventory_and_tec_small_scale_scaling_floor", "label": "AWH Minimum Practical Scale (Scaling Floor)", "file_type": "rationale", "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A VCR dehumidifier needs a compressor, refrigerant charge, and coils; below ~100 W cooling capacity fixed costs dominate and efficiency collapses, so commercial AWGs start at ~10-20 L/day. TEC tiles scale from ~1 W, so TEC's scaling floor is effectively zero - one $5 module yields ~100 mL/day, enough for a street-lamp cleaning cycle."}, {"id": "egypt_pv_inventory_and_tec_small_scale_lcow_breakeven", "label": "TEC-vs-VCR LCOW Breakeven Water Duty (~1.7-3.4 L/day)", "file_type": "rationale", "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The SEC-dominated LCOW term is scale-independent while the CAPEX term scales as 1/V_year; below roughly 1.7-3.4 L/day the smallest viable VCR's CAPEX is never amortised, so TEC has lower LCOW despite worse SEC. Street-lamp PV and much of residential rooftop sit on the TEC-preferred side; industrial and utility PV sit firmly on the VCR side."}], "edges": [{"source": "egypt_pv_inventory_and_tec_small_scale", "target": "egypt_pv_inventory_and_tec_small_scale_benban_solar_park", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "weight": 1.0}, {"source": "egypt_pv_inventory_and_tec_small_scale", "target": "egypt_pv_inventory_and_tec_small_scale_kom_ombo_pv", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "weight": 1.0}, {"source": "egypt_pv_inventory_and_tec_small_scale", "target": "egypt_pv_inventory_and_tec_small_scale_egyptera", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "weight": 1.0}, {"source": "egypt_pv_inventory_and_tec_small_scale", "target": "egypt_pv_inventory_and_tec_small_scale_scaling_floor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "egypt_pv_inventory_and_tec_small_scale.pdf", "source_location": null, "weight": 1.0}, {"source": "egypt_pv_inventory_and_tec_small_scale", "