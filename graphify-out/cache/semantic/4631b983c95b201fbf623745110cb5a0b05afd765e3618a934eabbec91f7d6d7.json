{"nodes": [{"id": "tec_vcr_sustainability_efficiency_maintenance_v1_2", "label": "TEC vs VCR - Sustainability, Efficiency, and Maintenance Analysis v1.2", "file_type": "document", "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tec_vcr_sustainability_efficiency_maintenance_v1_2_carnot_cop_ceiling", "label": "Carnot COP Ceiling and Second-Law Efficiency (COP_Carnot ~ 13 at Benban operating point)", "file_type": "concept", "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Carnot ceiling is a function of state, not device, so it is identical for TEC and VCR; the gap is in second-law efficiency: TEC 2.3-3.8% vs VCR 19-42% at the same temperature lift."}, {"id": "tec_vcr_sustainability_efficiency_maintenance_v1_2_zt_figure_of_merit", "label": "Thermoelectric Figure of Merit ZT (Bi2Te3 ~ 1.0)", "file_type": "rationale", "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commercial Bi2Te3 modules have ZT ~ 1.0, ceiling practical COP near 0.6-0.7 at small dT; emerging ZT->2 materials are not commercially available, so TEC's efficiency disadvantage is structural, not a manufacturing-maturity issue."}, {"id": "tec_vcr_sustainability_efficiency_maintenance_v1_2_refrigerant_gwp", "label": "Refrigerant GWP Liability of VCR (R-410A GWP 2088)", "file_type": "concept", "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single 3 kg R-410A charge equals 6264 kg CO2e (~14 MWh of Egyptian grid electricity); TEC uses no refrigerant, giving zero fugitive-GWP emissions and ~70% lower operational GHG when PV-powered, but VCR's 3-6x lower SEC outweighs this at grid emission factors above ~0.1 kgCO2e/kWh."}, {"id": "tec_vcr_sustainability_efficiency_maintenance_v1_2_tellurium_criticality", "label": "Tellurium Supply Criticality (global supply ~580 t/yr)", "file_type": "concept", "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TEC's only material-level sustainability liability: USGS lists Te among critical minerals and Egypt would import 100% of Peltier modules."}], "edges": [{"source": "tec_vcr_sustainability_efficiency_maintenance_v1_2", "target": "tec_single_vs_parallel_deployment_analysis_v1_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "weight": 1.0}, {"source": "tec_vcr_sustainability_efficiency_maintenance_v1_2", "target": "tec_deployment_analysis_v1_1_egypt_market_supplement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "weight": 1.0}, {"source": "tec_vcr_sustainability_efficiency_maintenance_v1_2", "target": "project_awh_benban_numbers_cost_quality", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "weight": 1.0}, {"source": "tec_vcr_sustainability_efficiency_maintenance_v1_2", "target": "tec_vcr_sustainability_efficiency_maintenance_v1_2_carnot_cop_ceiling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tec_vcr_sustainability_efficiency_maintenance_v1.2.pdf", "source_location": null, "weight": 1.0}, {"source": "tec_vcr_su