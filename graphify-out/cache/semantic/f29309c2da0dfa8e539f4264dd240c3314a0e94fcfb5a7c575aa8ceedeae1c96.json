{"nodes": [{"id": "docs_ree598_proposal_review", "label": "REE598 Proposal Engineering Review", "file_type": "document", "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ree598_proposal_review_energy_recovery_contradiction", "label": "Tables 6.1 vs 6.2 Energy Recovery Contradiction", "file_type": "concept", "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": "docs/REE598_PROPOSAL_REVIEW.md \u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Table 6.2 implies recovery of ~94% of annual yield, physically impossible; Table 6.1's 3.5% mean soiling-loss model is self-consistent, so 6.2 must be regenerated from the same model and tariff (Scale B payback ~9 years, not 1.9)."}, {"id": "docs_ree598_proposal_review_tec_sec_optimism", "label": "TEC Specific Energy Consumption Optimism (0.927 vs 2.8-12 kWh/L)", "file_type": "concept", "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": "docs/REE598_PROPOSAL_REVIEW.md \u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived SEC is 3-10x more optimistic than the cited literature; likely error is the air-side mass balance (8.4 m3/h assumed vs typical 2-4 m3/h for a 40x40 mm cold plate with a 60 mm fan); recompute with a datasheet fan curve and eta_c 0.30-0.60."}, {"id": "docs_ree598_proposal_review_hot_side_temperature", "label": "Coupled Peltier-Heat-Sink Operating Point (T_h ~50 C)", "file_type": "concept", "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": "docs/REE598_PROPOSAL_REVIEW.md \u00a73.3-3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "T_h is not a free parameter: T_h = T_amb + theta_sa*Q_h gives ~50 C (not ~35 C), lowering COP to ~0.28 and raising SEC; the claimed 0.5 K/W heat-sink resistance is 2-4x optimistic versus 50 mm extrusion datasheets (1.5-3 K/W)."}, {"id": "docs_ree598_proposal_review_scale_b_battery_sizing", "label": "Scale B Battery Sizing vs BOM Mismatch", "file_type": "concept", "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": "docs/REE598_PROPOSAL_REVIEW.md \u00a73.5-3.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computed requirement C_batt >= 2,420 Wh vs BOM 1,800 Wh LiFePO4 pack (25% undersized); BOM price $180 is below the 350-600 USD market range, pushing realistic Scale B total to ~900 USD and payback to ~13 years."}, {"id": "docs_ree598_proposal_review_scale_c_fleet_decomposition", "label": "Scale C Fleet Decomposition Recommendation", "file_type": "concept", "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": "docs/REE598_PROPOSAL_REVIEW.md \u00a73.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 1.67-tonne water reservoir on a mobile gantry is structurally demanding and rare in O&M practice; decomposing Scale C into >=4 Scale-B-class units aligns with the pivot toward modular, scale-replicable robots."}], "edges": [{"source": "docs_ree598_proposal_review", "target": "ree598_proposal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": "Source file", "weight": 1.0}, {"source": "docs_ree598_proposal_review", "target": "memory_project_context_project_pivot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": "\u00a74 Alignment with the Pivoted Project Direction", "weight": 1.0}, {"source": "docs_ree598_proposal_review_energy_recovery_contradiction", "target": "ree598_proposal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/REE598_PROPOSAL_REVIEW.md", "source_location": "