FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Zone the entire wedge as the packed bed 'bed' (porosity selectionMode cellZone).

actions
(
    {
        name    bed;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (-1e6 -1e6 -1e6) (1e6 1e6 1e6);
    }
    {
        name    bed;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     bed;
    }
);

