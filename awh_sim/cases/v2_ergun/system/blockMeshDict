/*--------------------------------*- C++ -*----------------------------------*\
| AWH Tier-2 — axisymmetric wedge packed bed (V2 Ergun Dp verification)        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mergeType points;          // wedge: merge points, not topology

scale   1;

L         0.09;                       // [m] bed length (axial, x)
R         0.10;                       // [m] bed radius (radial, y)
halfAngle 2.5;                        // [deg] wedge half-angle (<=2.5, i.e. 5 total)
rad       #calc "degToRad($halfAngle)";
dz        #calc "$R*Foam::tan($rad)";
mdz       #calc "-1.0*$dz";
nx        120;                        // axial cells
nr        30;                         // radial cells

vertices
(
    (0   0    0)       // 0  inlet  axis
    ($L  0    0)       // 1  outlet axis
    (0   $R   $mdz)    // 2  inlet  rim  (-z, back)
    ($L  $R   $mdz)    // 3  outlet rim  (-z, back)
    (0   $R   $dz)     // 4  inlet  rim  (+z, front)
    ($L  $R   $dz)     // 5  outlet rim  (+z, front)
);

blocks
(
    hex (0 1 3 2 0 1 5 4) ($nx $nr 1) simpleGrading (1 0.333 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces ( (0 2 4 0) );
    }
    outlet
    {
        type patch;
        faces ( (1 3 5 1) );
    }
    wall
    {
        type wall;
        faces ( (2 3 5 4) );
    }
    wedge_back
    {
        type wedge;
        faces ( (0 2 3 1) );
    }
    wedge_front
    {
        type wedge;
        faces ( (0 1 5 4) );
    }
);

mergePatchPairs
(
);

// ************************************************************************* //
