/*--------------------------------*- C++ -*----------------------------------*\
| AWH Tier-2 — axisymmetric wedge packed bed (V1 box / mass-balance test)      |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mergeType points;

scale   1;

L         0.09;
R         0.10;
halfAngle 2.5;
rad       #calc "degToRad($halfAngle)";
dz        #calc "$R*Foam::tan($rad)";
mdz       #calc "-1.0*$dz";
nx        40;
nr        12;

vertices
(
    (0   0    0)
    ($L  0    0)
    (0   $R   $mdz)
    ($L  $R   $mdz)
    (0   $R   $dz)
    ($L  $R   $dz)
);

blocks
(
    hex (0 1 3 2 0 1 5 4) ($nx $nr 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet  { type patch; faces ( (0 2 4 0) ); }
    outlet { type patch; faces ( (1 3 5 1) ); }
    wall   { type wall;  faces ( (2 3 5 4) ); }
    wedge_back  { type wedge; faces ( (0 2 3 1) ); }
    wedge_front { type wedge; faces ( (0 1 5 4) ); }
);

mergePatchPairs
(
);

// ************************************************************************* //
