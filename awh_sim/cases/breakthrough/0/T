FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 295;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 295;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 295;
        value           uniform 295;
    }
    wall        { type zeroGradient; }   // adiabatic during adsorption
    wedge_back  { type wedge; }
    wedge_front { type wedge; }
}

